# .env.example — copy to .env and fill in for each environment.
# NEVER commit a real .env file.

# === Django core ===
# Generate a fresh random key per environment:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True for local dev only. ALWAYS False in production.
DEBUG=False

# Comma-separated. Use specific hosts in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated full URLs (including scheme). Required for POST/CSRF over HTTPS.
CSRF_TRUSTED_ORIGINS=

# Comma-separated. Browsers JS allowed to call the API from these origins.
CORS_ALLOWED_ORIGINS=

# === MySQL ===
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306

# === Email (SMTP) ===
# Defaults are for Gmail; override per provider.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
